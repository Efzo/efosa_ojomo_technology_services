generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  role          Role      @default(VIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  pageVersions  PageVersion[] @relation("PageVersionAuthor")
  mediaAssets   MediaAsset[] @relation("MediaUploader")
  auditEvents   AuditEvent[] @relation("AuditActor")
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model Lead {
  id              String   @id @default(cuid())
  name            String
  email           String
  company         String
  website         String?
  serviceRequested String
  challenge       String
  timeline        String
  budget          String?
  leadSource      String?
  consentAt       DateTime
  status          LeadStatus @default(NEW)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  businessClient  BusinessClient?
}

// Private owner workspace. Monetary values are USD cents; business dates are
// ISO calendar dates so deadlines do not shift across browser time zones.
model BusinessClient {
  id           String @id @default(cuid())
  version      Int @default(0)
  leadId       String? @unique
  lead         Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company      String
  contactName  String
  email        String
  phone        String @default("")
  billingAddress String @default("")
  status       String @default("PROSPECT")
  source       String @default("")
  nextAction   String @default("")
  followUpDate String @default("")
  notes        String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  engagements BusinessEngagement[]
  invoices BusinessInvoice[]
  documents BusinessDocument[]
  @@index([status, followUpDate])
}

model BusinessEngagement {
  id          String @id @default(cuid())
  version     Int @default(0)
  clientId    String
  client      BusinessClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title       String
  service     String
  kind        String @default("PROJECT")
  status      String @default("PROPOSAL")
  feeCents    Int @default(0)
  scope       String @default("")
  exclusions  String @default("")
  acceptance  String @default("")
  clientInputs String @default("")
  agreementUrl String @default("")
  signedDate  String @default("")
  initialPaymentReference String @default("")
  startDate   String @default("")
  dueDate     String @default("")
  acceptedDate String @default("")
  renewalDate String @default("")
  monthlyMinutes Int @default(0)
  coverage    String @default("")
  serviceHours String @default("")
  responseTarget String @default("")
  rolloverTerms String @default("")
  cancellationTerms String @default("")
  notes       String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       BusinessTask[]
  invoices    BusinessInvoice[]
  documents   BusinessDocument[]
  timeEntries BusinessTimeEntry[]
  @@index([status, dueDate])
  @@index([clientId])
}

model BusinessTask {
  id          String @id @default(cuid())
  version     Int @default(0)
  seedKey     String? @unique
  engagementId String?
  engagement  BusinessEngagement? @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  title       String
  status      String @default("TODO")
  category    String @default("DELIVERY")
  priority    String @default("NORMAL")
  dueDate     String @default("")
  owner       String @default("Efosa Ojomo")
  notes       String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, dueDate])
  @@index([engagementId])
}

model BusinessInvoice {
  id          String @id @default(cuid())
  version     Int @default(0)
  clientId    String
  client      BusinessClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  engagementId String?
  engagement  BusinessEngagement? @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  number      String @unique
  status      String @default("DRAFT")
  description String
  subtotalCents Int
  taxCents    Int @default(0)
  billedTo    String
  billingEmail String
  billingAddress String @default("")
  issueDate   String
  dueDate     String
  paymentUrl  String @default("")
  notes       String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  payments    BusinessPayment[]
  @@index([status, dueDate])
  @@index([clientId])
  @@index([engagementId])
}

model BusinessPayment {
  id          String @id @default(cuid())
  invoiceId   String
  invoice     BusinessInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  kind        String @default("PAYMENT")
  amountCents Int
  feeCents    Int @default(0)
  date        String
  method      String
  reference   String @unique
  notes       String @default("")
  createdAt   DateTime @default(now())
  @@index([invoiceId])
  @@index([date])
}

model BusinessExpense {
  id          String @id @default(cuid())
  version     Int @default(0)
  vendor      String
  description String
  category    String
  amountCents Int
  date        String
  receiptUrl  String @default("")
  notes       String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([date])
}

model BusinessTimeEntry {
  id          String @id @default(cuid())
  version     Int @default(0)
  engagementId String
  engagement  BusinessEngagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  date        String
  minutes     Int
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([engagementId, date])
}

model BusinessDocument {
  id          String @id @default(cuid())
  version     Int @default(0)
  clientId    String
  client      BusinessClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  engagementId String?
  engagement  BusinessEngagement? @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  title       String
  kind        String
  status      String @default("DRAFT")
  body        String
  externalUrl String @default("")
  folder      String @default("GENERAL")
  sentDate    String @default("")
  signedDate  String @default("")
  files       BusinessDocumentFile[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([clientId])
  @@index([engagementId])
  @@index([clientId, folder, updatedAt])
}

model BusinessDocumentFile {
  id           String @id @default(cuid())
  documentId   String
  document     BusinessDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revision     Int
  storageKey   String @unique
  filename     String
  mimeType     String
  size         Int
  revisionNote String
  status       String @default("DRAFT")
  sentDate     String @default("")
  signedDate   String @default("")
  uploadedById String
  createdAt    DateTime @default(now())
  @@unique([documentId, revision])
  @@index([documentId, createdAt])
}

enum LeadStatus {
  NEW
  QUALIFIED
  DISCOVERY_SCHEDULED
  PROPOSAL_SENT
  WON
  LOST
}

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  shortDescription String
  fullDescription  String
  targetAudience   String
  problemsSolved   String[]
  deliverables     String[]
  engagementProcess String[]
  ctaText          String
  price            String?
  metaTitle        String?
  metaDescription  String?
  createdAt       DateTime @default(now())
  isPublished      Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model CaseStudy {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  summary           String
  category          String
  businessProblem   String
  role              String
  requirements      String
  architecture      String
  stack             String[]
  implementation    String
  challenges        String
  outcomes          String
  images            String[]
  relatedServices   String[]
  status            ContentStatus @default(DRAFT)
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EngagementModel {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  description       String
  price             String
  features          String[]
  type              EngagementType @default(FIXED)
  ctaText           String
  relatedServices   String[]
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum EngagementType {
  FIXED
  RETAINER
  HOURLY
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  content         String
  category        String
  featuredImage   String?
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  versions        BlogPostVersion[]
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPostVersion {
  id         String   @id @default(cuid())
  blogPostId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  version    Int
  title      String
  excerpt    String
  content    String
  category   String
  createdAt  DateTime @default(now())
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         Json
  metaTitle       String?
  metaDescription String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt
  versions         PageVersion[]
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model PageVersion {
  id              String   @id @default(cuid())
  pageId          String
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version         Int
  title           String
  content         Json
  metaTitle       String?
  metaDescription String?
  createdById     String?
  createdBy       User?    @relation("PageVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  storageKey   String   @unique
  filename     String
  altText      String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([target])
}

model VideoInsight {
  id          String   @id @default(cuid())
  title       String
  description String
  url         String
  category    String
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
